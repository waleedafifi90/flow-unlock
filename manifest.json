{
  "manifest_version": 3,
  "name": "Flow Unlock",
  "version": "2.1.1",
  "minimum_chrome_version": "111",
  "description": "يفتح Google Flow من أي دولة بتعديل فحص الدولة داخل المتصفح، بدون بروكسي أو VPN.",
  "permissions": ["scripting", "storage", "proxy", "webRequest", "webRequestAuthProvider", "alarms"],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://accounts.google.com/*",
    "https://*.googleapis.com/*",
    "https://*.gstatic.com/*",
    "https://apis.google.com/*",
    "https://play.google.com/*"
  ],
  "optional_host_permissions": ["http://*/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow Unlock",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
