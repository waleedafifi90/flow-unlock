{
  "manifest_version": 3,
  "name": "Flow Unlock",
  "version": "2.1.1",
  "description": "يفتح Google Flow من أي دولة بتعديل فحص الدولة داخل المتصفح، بدون بروكسي أو VPN.",
  "browser_specific_settings": {
    "gecko": {
      "id": "flow-unlock@waleedafifi",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["scripting", "storage", "proxy", "webRequest"],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "https://accounts.google.com/*",
    "https://*.googleapis.com/*",
    "https://*.gstatic.com/*",
    "https://apis.google.com/*",
    "https://play.google.com/*"
  ],
  "background": { "scripts": ["proxy-core.js", "background.js"] },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow Unlock",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
